{
  "name": "drugstore-admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "verify:api": "node --conditions=react-server --import tsx scripts/verify-api.ts",
    "verify:session": "node --import tsx scripts/verify-session.ts",
    "verify:board": "node --import tsx scripts/verify-board.ts",
    "verify:all": "npm run verify:i18n && npm run verify:api && npm run cooldown && npm run verify:session && npm run cooldown && npm run verify:board && npm run cooldown && npm run verify:writes",
    "cooldown": "node -e \"console.log('  cooling down 65s so the API 100/min per-user budget resets');setTimeout(function(){}, 65000)\"",
    "verify:compliance": "node --import tsx scripts/verify-compliance.ts",
    "verify:writes": "node --import tsx scripts/verify-writes.ts",
    "verify:i18n": "node --import tsx scripts/verify-i18n.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
